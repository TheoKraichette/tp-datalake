# Copier ce fichier en .env avant de lancer `docker compose up -d`
#   cp .env.example .env

# PostgreSQL — métadonnées
POSTGRES_USER=datalake
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=pokemon_lake
POSTGRES_HOST_PORT=5434

# MinIO (stockage objet compatible S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-moi
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# n8n (orchestration des workflows)
N8N_HOST_PORT=5678
# Générer une clé : openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Adminer (UI web PostgreSQL)
ADMINER_HOST_PORT=8089
